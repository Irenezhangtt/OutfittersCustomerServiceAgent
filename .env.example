# SQLite works without any external service. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./sierra.db
DEMO_MODE=true
DEMO_PASSWORD=trail-demo
# Change both values before sharing the application. Never commit .env.
COUPON_SECRET=local-demo-only-change-me
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
POSTGRES_PASSWORD=sierra-local-only
# Optional: bounded LLM intent planning; all business authorization stays in Python.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_SECONDS=2.5
REQUEST_TIMEOUT_SECONDS=8
SESSION_HOURS=12
MEMORY_CHAR_BUDGET=12000
# Optional local-only customer dataset. Keep it under ignored data/private/.
# ORDER_DATA_PATH=data/private/CustomerOrders.json
